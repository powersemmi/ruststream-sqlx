  "query": "UPDATE `checked_ledger` SET `locked_until` = ?, `attempt` = `attempt` + 1 WHERE `id` IN (SELECT `id` FROM `checked_ledger` WHERE `id` = (SELECT `id` FROM `checked_ledger` WHERE `account` = ? ORDER BY `id` LIMIT 1) AND (`locked_until` IS NULL OR `locked_until` <= ?) AND NOT EXISTS (SELECT 1 FROM `checked_ledger` AS __work WHERE __work.`account` = ? AND __work.`locked_until` > ?)) RETURNING `id`, `account`, `attempt` - 1 AS `attempt`, `locked_until`, `payload`",
