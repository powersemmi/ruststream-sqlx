  "query": "WITH __claimed AS (SELECT \"id\", \"account\", \"attempt\", \"locked_until\", \"payload\" FROM \"checked_ledger\" WHERE \"id\" = (SELECT \"id\" FROM \"checked_ledger\" WHERE \"account\" = $1 ORDER BY \"id\" LIMIT 1) AND (\"locked_until\" IS NULL OR \"locked_until\" <= $2) AND NOT EXISTS (SELECT 1 FROM \"checked_ledger\" AS __work WHERE __work.\"account\" = $3 AND __work.\"locked_until\" > $4) FOR UPDATE SKIP LOCKED), __stamped AS (UPDATE \"checked_ledger\" AS __row SET \"locked_until\" = $5, \"attempt\" = __row.\"attempt\" + 1 FROM __claimed WHERE __row.\"id\" = __claimed.\"id\") SELECT * FROM __claimed ORDER BY \"id\"",
