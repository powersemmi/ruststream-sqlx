  "query": "SELECT `id`, `account`, `attempt`, `locked_until`, `payload` FROM `checked_ledger` WHERE `id` = (SELECT `id` FROM `checked_ledger` WHERE `account` = ? ORDER BY `id` LIMIT 1) AND (`locked_until` IS NULL OR `locked_until` <= ?) AND NOT EXISTS (SELECT 1 FROM `checked_ledger` AS __work WHERE __work.`account` = ? AND __work.`locked_until` > ?) FOR UPDATE SKIP LOCKED",
